{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)\\.html", "destination": "/$1" },
    { "source": "/api/mail", "destination": "/assets/mail.php" }
  ],
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "assets/mail.php", "use": "@vercel/php" },
    { "src": "assets/**/*", "use": "@vercel/static" }
  ]
}
